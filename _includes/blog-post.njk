<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Red Ruby Cleaning Co.</title>
  <meta name="description" content="{{ excerpt | default(title) }}">
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" type="image/png" href="/logo.png">
</head>
<body class="blog-post-page">
<div class="union-jack-strip"></div>
<div class="top-bar">
  <span>🇬🇧 Proudly British Owned & Operated</span>
  <span class="divider">✦</span>
  <span>📍 Cambridge, UK</span>
  <span class="divider">✦</span>
  <span>Fully Insured & Uniformed Staff</span>
</div>

<header>
  <div class="nav-container">
    <div class="hamburger" onclick="document.querySelector('nav ul').classList.toggle('open')"><span></span><span></span><span></span></div>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About Us</a></li>
        <li class="dropdown-trigger">
          <a href="#">Services</a>
          <div class="mega-dropdown">
            <div class="mega-dropdown-grid">
              <div>
                <div class="mega-dropdown-heading">Airbnb & Short Lets</div>
                <a href="/services/airbnb-cleaning-cambridge/">Airbnb Cleaning Cambridge</a>
                <a href="/services/short-let-cleaning-cambridge/">Short Let Cleaning Cambridge</a>
                <a href="/services/vacation-rental-cleaning-cambridge/">Vacation Rental Cleaning</a>
                <a href="/services/holiday-let-cleaning-cambridge/">Holiday Let Cleaning Cambridge</a>
                <a href="/services/turnover-cleaning-cambridge/">Turnover Cleaning Cambridge</a>
                <a href="/services/booking-com-cleaning-cambridge/">Booking.com Property Cleaning</a>
              </div>
              <div>
                <div class="mega-dropdown-heading">Specialist Services</div>
                <a href="/services/end-of-tenancy-cleaning-cambridge/">End of Tenancy Cleaning</a>
                <a href="/services/deep-cleaning-cambridge/">Deep Cleaning Cambridge</a>
                <a href="/services/linen-laundry-service-cambridge/">Linen &amp; Laundry Service</a>
                <a href="/services/property-management-cleaning-cambridge/">Property Management Cleaning</a>
                <a href="/services/student-let-cleaning-cambridge/">Student Let Cleaning</a>
                <a href="/services/serviced-accommodation-cleaning-cambridge/">Serviced Accommodation Cleaning</a>
              </div>
            </div>
          </div>
        </li>
        <li><a href="/blog/" class="active">Blog</a></li>
        <li><a href="/contact/" class="btn-primary" style="padding:12px 25px;margin:13px 0;font-size:1rem;">Get a Quote</a></li>
      </ul>
    </nav>
  </div>
</header>

<section class="service-hero">
  <div class="blog-post-hero-content">
    <h1>{{ title }}</h1>
    <p style="font-family:'Playfair Display',serif;font-style:italic;color:var(--grey);font-size:1.1rem;margin-top:10px;">
      {{ excerpt | default("Practical cleaning and hosting advice from Cambridge's favourite cleaners.") }}
    </p>
    <p class="blog-date" style="margin-top:10px;">
      {{ date | postDate }}
    </p>
  </div>
</section>

<section class="service-body">
  {% if featured_image %}
  <figure class="blog-post-featured-image">
    <img src="{{ featured_image }}" alt="{{ title }}">
  </figure>
  {% endif %}
  {{ content | safe }}
</section>

<section class="section">
  <div class="section-heading">
    <h2>Related Posts</h2>
    <div class="line"></div>
  </div>
  <div class="blog-grid">
    {% set relatedCount = 0 %}
    {% for post in collections.posts %}
    {% if post.url != page.url and relatedCount < 3 %}
    <div class="blog-card fade-in">
      <div class="blog-thumb">
        {% if post.data.featured_image %}
        <img src="{{ post.data.featured_image }}" alt="{{ post.data.title }}" class="blog-thumb-image">
        {% else %}
        {{ post.data.hero_emoji or "🧼" }}
        {% endif %}
      </div>
      <div class="blog-card-body">
        <div class="blog-date">{{ post.date | postDate }}</div>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.excerpt }}</p>
        <a href="{{ post.url }}" class="card-link">Read More →</a>
      </div>
    </div>
    {% set relatedCount = relatedCount + 1 %}
    {% endif %}
    {% endfor %}
  </div>

  <div style="text-align:center;">
    <a href="/blog/" class="btn btn-outline">← Back to all articles</a>
  </div>
</section>

<footer>
  <div class="footer-main">
    <div class="footer-brand">
      <img src="/logo.png" alt="Red Ruby Cleaning Co.">
      <p>Cambridge's premier Airbnb and short-term let cleaning service. British owned, locally operated. <em>We came, we saw, we cleaned.</em></p>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Services</h4>
      <ul>
        <li><a href="/services/airbnb-cleaning-cambridge/">Airbnb Cleaning</a></li>
        <li><a href="/services/short-let-cleaning-cambridge/">Short Let Cleaning</a></li>
        <li><a href="/services/vacation-rental-cleaning-cambridge/">Vacation Rental Cleaning</a></li>
        <li><a href="/services/holiday-let-cleaning-cambridge/">Holiday Let Cleaning</a></li>
        <li><a href="/services/turnover-cleaning-cambridge/">Turnover Cleaning</a></li>
        <li><a href="/services/deep-cleaning-cambridge/">Deep Cleaning</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>More Services</h4>
      <ul>
        <li><a href="/services/end-of-tenancy-cleaning-cambridge/">End of Tenancy</a></li>
        <li><a href="/services/linen-laundry-service-cambridge/">Linen & Laundry</a></li>
        <li><a href="/services/booking-com-cleaning-cambridge/">Booking.com Cleaning</a></li>
        <li><a href="/services/property-management-cleaning-cambridge/">Property Mgmt Cleaning</a></li>
        <li><a href="/services/student-let-cleaning-cambridge/">Student Let Cleaning</a></li>
        <li><a href="/services/serviced-accommodation-cleaning-cambridge/">Serviced Accommodation</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; 2025 Red Ruby Cleaning Co. Ltd · Company No. 14823671 · Registered in England & Wales · Cambridge, UK</p>
    <p style="margin-top:5px;">Proudly British. Properly insured. Spotlessly Cambridge. · <a href="/llm.txt">llm.txt</a></p>
  </div>
</footer>
<div class="union-jack-strip"></div>
</body>
</html>

